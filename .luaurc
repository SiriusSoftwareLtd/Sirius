{
    "languageMode": "nonstrict",
    "lintErrors": true,
    "lint": {
        "*": true,
        // Several handlers return early on a guard and fall through otherwise; that's intended.
        "ImplicitReturn": false,
        // if/else branches that animate to the same value are deliberate in the tween code.
        "DuplicateCondition": false
    },
    "globals": [
        "writefile",
        "readfile",
        "appendfile",
        "isfile",
        "delfile",
        "listfiles",
        "makefolder",
        "isfolder",
        "delfolder",
        "cloneref",
        "gethui",
        "getcustomasset",
        "getgenv",
        "getfenv",
        "getconnections",
        "hookmetamethod",
        "getnamecallmethod",
        "identifyexecutor",
        "setfpscap",
        "setclipboard",
        "request",
        "http_request",
        "http",
        "syn",
        "fluxus",
        "script_key",
        "Essential",
        "loadstring"
    ]
}
